#!/usr/bin/env bash
# Copy Mistral's ALT Mistral display font into public/fonts/ for local use.
# ALT Mistral is licensed to Mistral for its own use only, so the files are
# git-ignored and never committed. Without them, headings fall back to Inter.
#
# Source: the mistral-pixel-design skill's brand kit, or set FONT_DIR.
set -euo pipefail
cd "$(dirname "$0")/.."
FONT_DIR="${FONT_DIR:-$HOME/.agents/skills/mistral-pixel-design/assets/fonts}"
if [ ! -f "$FONT_DIR/ALTMistral-Medium.woff2" ]; then
  echo "ALT Mistral not found in $FONT_DIR. Headings will use Inter." >&2
  exit 0
fi
mkdir -p public/fonts
cp "$FONT_DIR/ALTMistral-Regular.woff2" "$FONT_DIR/ALTMistral-Medium.woff2" public/fonts/
echo "Copied ALT Mistral into public/fonts/ (git-ignored)."
