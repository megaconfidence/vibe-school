#!/usr/bin/env bash
# Fail if the committed zips in public/ or src/examples/ don't match their
# sources. Compares entry names and CRCs, not bytes, so zip tool versions and
# file permissions don't matter.
set -euo pipefail
cd "$(dirname "$0")/.."

ZIPS=(public/plugin/vibe-school.zip public/examples/starter.zip public/examples/agents-skills-instructions.zip)
BEFORE="$(mktemp -d)"
trap 'rm -rf "$BEFORE"' EXIT

listing() { unzip -v "$1" | awk 'NR>3 && $7 ~ /^[0-9a-f]{8}$/ {print $7, $8}' | LC_ALL=C sort; }

for z in "${ZIPS[@]}"; do listing "$z" > "$BEFORE/$(basename "$z").txt"; done
script/build-assets > /dev/null

status=0
for z in "${ZIPS[@]}"; do
  if ! diff -u "$BEFORE/$(basename "$z").txt" <(listing "$z"); then
    echo "::error::$z is out of date. Run script/build-assets and commit the result."
    status=1
  fi
done
if ! git diff --quiet -- src/examples; then
  echo "::error::src/examples/ is out of date. Run script/build-assets and commit the result."
  git diff --stat -- src/examples
  status=1
fi
exit $status
